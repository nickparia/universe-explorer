<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron's V8 requires JIT under the hardened runtime; this is
       the one exception the cockpit needs. Everything else stays at
       Apple's hardened defaults. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>
